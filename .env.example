# CloudWise AI - Backend Environment Configuration Template
# Copy this file to .env and update values for your environment

# ─── Application ───
APP_NAME="CloudWise AI"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# ─── Database ───
# Managed PostgreSQL (Use public Oregon URL for external connection):
# DATABASE_URL="postgresql://cloudwise_user:password@dpg-d911bemgvqtc739tr500-a.oregon-postgres.render.com/cloudwise"
# Internal Render URL for deployment:
# DATABASE_URL="postgresql://cloudwise_user:password@dpg-d911bemgvqtc739tr500-a/cloudwise"
# Fallback SQLite database for local offline development:
DATABASE_URL="sqlite:///./cloudwise.db"

# ─── Security ───
# Generate a cryptographically secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="placeholder-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AWS Configuration (AWS Academy Learner Lab Session) ───
# Note: AWS Academy Learner Lab operates under a restricted "voclabs" role.
# Long-term IAM user creation (iam:CreateUser) and access keys are blocked.
# You must dynamically input AWS Academy temporary credentials from your Learner Lab session:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION="us-east-1"

# ─── Redis / Celery (Optional) ───
# Required for background task scheduling.
REDIS_URL="redis://127.0.0.1:6379"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"

# ─── Gemini (Optional) ───
# GEMINI_API_KEY=

# ─── CORS ───
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
